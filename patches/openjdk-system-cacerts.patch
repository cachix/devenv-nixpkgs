From b1e20b25b1ce70bfae35f3abda428cb226921b50 Mon Sep 17 00:00:00 2001
From: zimbatm <zimbatm@zimbatm.com>
Date: Tue, 20 Oct 2026 18:32:00 +0000
Subject: [PATCH] openjdk: generate cacerts from cacert for JDK 11+

JDK 8 already builds its cacerts from cacert. JDK 11 and later shipped
the CA list that comes with the OpenJDK source. That list does not get
the cacert updates, for example the removal of distrusted roots.

Generate the keystore with the bootstrap keytool before configure and
give it to --with-cacerts-file. The file goes into the java.base jmod,
so jlink images such as jre_minimal also use it.

Write a PKCS12 store without a password, like upstream. The JDK opens
cacerts without a password, so it cannot read certificates that a
password protects.

Assisted-by: Claude Code (claude-opus-5)
---
 pkgs/development/compilers/openjdk/generic.nix | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/pkgs/development/compilers/openjdk/generic.nix b/pkgs/development/compilers/openjdk/generic.nix
index 8de868bb664be..78980adcf7973 100644
--- a/pkgs/development/compilers/openjdk/generic.nix
+++ b/pkgs/development/compilers/openjdk/generic.nix
@@ -398,6 +398,18 @@ stdenv.mkDerivation (finalAttrs: {
     # Set number of jobs to use when building.
     ''
       configureFlags+=("--with-jobs=''${NIX_BUILD_CORES}")
+    ''
+    # Build lib/security/cacerts from cacert instead of the bundled CA list.
+    # It goes into the java.base jmod, so jlink images also get it.
+    # Like upstream, write a PKCS12 store without a password: the JDK opens
+    # cacerts without one, and cannot read password-protected certificates.
+    + lib.optionalString atLeast11 ''
+      mkdir "$NIX_BUILD_TOP/cacerts-gen"
+      pushd "$NIX_BUILD_TOP/cacerts-gen"
+      JAVA_TOOL_OPTIONS="-Dkeystore.pkcs12.certProtectionAlgorithm=NONE -Dkeystore.pkcs12.macAlgorithm=NONE" \
+        ${jre-generate-cacerts} ${jdk-bootstrap'.home}/bin/keytool ${cacert}/etc/ssl/certs/ca-bundle.crt
+      popd
+      configureFlags+=("--with-cacerts-file=$NIX_BUILD_TOP/cacerts-gen/cacerts")
     '';
 
   env = {
